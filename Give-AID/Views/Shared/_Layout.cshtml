@{
    // Highlights the current page in the navbar.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var navItems = new[]
    {
        new { Text = "Home",           Url = Url.Action("Index", "Home"),       Key = "Home" },
        new { Text = "Donate",         Url = Url.Action("Index", "Donate"),     Key = "Donate" },
        new { Text = "Programmes",     Url = Url.Action("Index", "Programmes"), Key = "Programmes" },
        new { Text = "Help Centre",    Url = Url.Action("Index", "HelpCentre"), Key = "HelpCentre" },
        new { Text = "Invite Friends", Url = Url.Action("Index", "Invite"),     Key = "Invite" },
        new { Text = "About Us",       Url = (string?)(Url.Action("Index", "Home") + "#about-section"),    Key = "-" },
        new { Text = "Our Partners",   Url = (string?)(Url.Action("Index", "Home") + "#partners-section"), Key = "-" },
    };

    const string activeCls = "px-space-md py-space-xs transition-all duration-200 bg-primary-container text-on-primary font-semibold rounded-full";
    const string idleCls = "px-space-md py-space-xs font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container rounded-full transition-all duration-200";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface">

    <!-- ===== HEADER / NAVBAR ===== -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-20 max-w-[1440px] mx-auto px-margin-mobile md:px-margin flex items-center justify-between gap-space-md">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm shrink-0">
                <span class="w-9 h-9 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-secondary-container text-[20px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                </span>
                <span class="font-headline-sm text-headline-sm text-primary font-bold tracking-tight">Give<span class="text-secondary">-AID</span></span>
            </a>

            <nav class="hidden xl:flex items-center gap-space-xs p-1 rounded-full bg-surface-container-low">
                @foreach (var item in navItems)
                {
                    var active = item.Key == controller;
                    <a href="@item.Url" class="@(active ? activeCls : idleCls)" aria-current="@(active ? "page" : null)">@item.Text</a>
                }
            </nav>

            <div class="flex items-center gap-space-sm shrink-0">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Donate" asp-action="History" class="hidden sm:inline-flex items-center gap-1 px-space-md py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-primary font-label-md text-label-md font-semibold transition-colors">
                        <span class="material-symbols-outlined text-[18px] text-secondary" style="font-variation-settings: 'FILL' 1;">account_circle</span>
                        <span>@(User.Identity.Name ?? "Donor")</span>
                    </a>
                    <a asp-controller="Donate" asp-action="History" title="My Donations" class="hidden md:inline-flex items-center gap-1 font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors">
                        <span>My Donations</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center justify-center bg-surface-container hover:bg-error-container/30 text-primary hover:text-error px-space-md py-1.5 rounded-full font-label-md text-label-md transition-colors duration-200 uppercase tracking-wide">
                            Log Out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="hidden sm:inline-flex items-center justify-center bg-secondary hover:bg-secondary-container text-on-secondary px-space-lg py-space-sm rounded-full font-label-lg text-label-lg transition-colors duration-200 uppercase tracking-wide shadow-[0_1px_3px_0_rgba(11,69,69,0.04)]">Register / Log In</a>
                    <a asp-controller="Account" asp-action="Register" class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0" aria-label="My account">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </a>
                }
                <!-- Mobile menu toggle (below xl) -->
                <button id="navToggle" type="button" class="xl:hidden w-10 h-10 rounded-full flex items-center justify-center text-primary hover:bg-surface-container" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>
        </div>

        <!-- Mobile nav panel -->
        <nav id="mobileNav" class="hidden xl:hidden border-t border-outline-variant/40 bg-surface px-margin-mobile md:px-margin py-space-md">
            <div class="flex flex-col gap-space-xs max-w-[1440px] mx-auto">
                @foreach (var item in navItems)
                {
                    var active = item.Key == controller;
                    <a href="@item.Url" class="@(active ? activeCls : idleCls) py-space-sm">@item.Text</a>
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Donate" asp-action="History" class="sm:hidden mt-space-sm inline-flex items-center justify-between bg-surface-container text-primary px-space-lg py-space-sm rounded-full font-label-lg text-label-lg">
                        <span>My Donations (@(User.Identity.Name ?? "Donor"))</span>
                        <span class="material-symbols-outlined text-[18px]">account_circle</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sm:hidden mt-space-xs">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full inline-flex items-center justify-center bg-error-container/30 text-error px-space-lg py-space-sm rounded-full font-label-lg text-label-lg uppercase tracking-wide">Log Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="sm:hidden mt-space-sm inline-flex items-center justify-center bg-secondary text-on-secondary px-space-lg py-space-sm rounded-full font-label-lg text-label-lg uppercase tracking-wide">Register / Log In</a>
                }
            </div>
        </nav>
    </header>

    <!-- ===== PAGE CONTENT ===== -->
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="w-full bg-primary text-on-primary pt-space-xl pb-space-lg">
        <div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-gutter pb-space-xl">
                <div class="lg:col-span-4 flex flex-col gap-space-md">
                    <div class="flex items-center gap-space-sm">
                        <span class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-secondary-container text-[20px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                        </span>
                        <span class="font-headline-sm text-headline-sm text-on-primary font-bold tracking-tight">Give-AID</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-primary-container max-w-sm">Empowering verified grassroots NGOs to bring relief, education, healthcare and dignity to communities worldwide.</p>
                    <div class="inline-flex items-center gap-space-xs px-space-sm py-space-xs rounded-lg bg-primary-container/40 text-on-primary-container w-fit">
                        <span class="material-symbols-outlined text-[16px]">verified</span>
                        <span class="font-label-sm text-label-sm tracking-wider uppercase">Registered Charity • UN ECOSOC Accredited</span>
                    </div>
                </div>

                <div class="lg:col-span-2 flex flex-col gap-space-sm">
                    <h3 class="font-title-sm text-title-sm text-on-primary font-semibold tracking-normal uppercase">Quick Links</h3>
                    <ul class="flex flex-col gap-space-xs font-body-sm text-body-sm text-on-primary-container">
                        <li><a asp-controller="Home" asp-action="Index" class="hover:text-on-primary transition-colors">Home</a></li>
                        <li><a asp-controller="Donate" asp-action="Index" class="hover:text-on-primary transition-colors">Donate to a Cause</a></li>
                        <li><a asp-controller="Programmes" asp-action="Index" class="hover:text-on-primary transition-colors">Browse Programmes</a></li>
                        <li><a asp-controller="Invite" asp-action="Index" class="hover:text-on-primary transition-colors">Invite a Friend</a></li>
                        <li><a asp-controller="HelpCentre" asp-action="Index" class="hover:text-on-primary transition-colors">Help &amp; FAQs</a></li>
                    </ul>
                </div>

                <div class="lg:col-span-3 flex flex-col gap-space-sm">
                    <h3 class="font-title-sm text-title-sm text-on-primary font-semibold tracking-normal uppercase">Contact Us</h3>
                    <div class="flex flex-col gap-space-xs">
                        <div class="flex items-start gap-space-xs">
                            <span class="material-symbols-outlined text-secondary-fixed text-[18px] mt-0.5">call</span>
                            <span class="font-body-sm text-body-sm text-on-primary-container">+1 (800) 448-3243</span>
                        </div>
                        <div class="flex items-start gap-space-xs">
                            <span class="material-symbols-outlined text-secondary-fixed text-[18px] mt-0.5">mail</span>
                            <span class="font-body-sm text-body-sm text-on-primary-container">support@@give-aid.org</span>
                        </div>
                        <div class="flex items-start gap-space-xs">
                            <span class="material-symbols-outlined text-secondary-fixed text-[18px] mt-0.5">location_on</span>
                            <span class="font-body-sm text-body-sm text-on-primary-container">Global HQ: 240 Welfare Way, Suite 400</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-3 flex flex-col gap-space-sm">
                    <h3 class="font-title-sm text-title-sm text-on-primary font-semibold tracking-normal uppercase">Newsletter</h3>
                    <p class="font-body-sm text-body-sm text-on-primary-container">Stay inspired by stories of change directly from our verified field coordinators.</p>
                    @* TODO (backend): post to a Newsletter action *@
                    <form class="flex items-center gap-space-xs" onsubmit="event.preventDefault();">
                        <input name="Email" class="w-full px-space-md py-space-sm rounded-lg bg-primary-container text-on-primary placeholder:text-on-primary-container font-body-sm text-body-sm focus:outline-none focus:ring-1 focus:ring-secondary" placeholder="Enter your email address" type="email" required />
                        <button class="bg-secondary hover:bg-secondary-container text-on-secondary px-space-md py-space-sm rounded-lg font-label-md text-label-md transition-colors shrink-0 uppercase tracking-wide" type="submit">Subscribe</button>
                    </form>
                </div>
            </div>

            <div class="pt-space-lg flex flex-col md:flex-row items-center justify-between gap-space-md bg-primary-container/20 rounded-xl px-space-lg py-space-md">
                <p class="font-body-sm text-body-sm text-on-primary-container text-center md:text-left">Copyright © @DateTime.Now.Year Give-AID Global Welfare Foundation. All rights reserved. Backed by corporate alliance partners.</p>
                <div class="flex items-center gap-space-md text-on-primary-container">
                    <a href="#" aria-label="Website" class="material-symbols-outlined text-[20px] hover:text-on-primary transition-colors">public</a>
                    <a href="#" aria-label="Share" class="material-symbols-outlined text-[20px] hover:text-on-primary transition-colors">share</a>
                    <a href="#" aria-label="Community" class="material-symbols-outlined text-[20px] hover:text-on-primary transition-colors">group</a>
                    <a href="#" aria-label="Instagram" class="material-symbols-outlined text-[20px] hover:text-on-primary transition-colors">photo_camera</a>
                    <a href="#" aria-label="YouTube" class="material-symbols-outlined text-[20px] hover:text-on-primary transition-colors">smart_display</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
