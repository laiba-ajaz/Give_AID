@model ContactMessage
@{
    ViewData["Title"] = "Contact Us";
    var info = (ContactInfo)ViewBag.Info;
    var sentBy = TempData["ContactSent"] as string;

    const string inputCls = "w-full bg-surface-container-low text-on-surface px-space-md py-space-sm rounded-lg font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all";
    const string labelCls = "font-label-md text-label-md text-on-surface font-semibold";
    const string errorCls = "font-body-sm text-body-sm text-error";
}

<div class="flex flex-col w-full">

<!-- ===== PAGE INTRO ===== -->
<section class="w-full bg-primary text-on-primary py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
    <nav class="flex items-center gap-space-xs text-on-primary-container font-label-md text-label-md mb-space-md">
        <a class="hover:text-on-primary transition-colors" asp-controller="Home" asp-action="Index">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-on-primary font-semibold">Contact Us</span>
    </nav>
    <h1 class="font-headline-lg text-headline-lg font-normal max-w-3xl">We'd love to hear from you</h1>
    <p class="font-body-md text-body-md text-on-primary-container mt-space-xs max-w-2xl">
        Questions about a donation, partnering with us, volunteering or a job opening – send us a message and our team will get back to you.
    </p>
</div>
</section>

<section class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">

    <!-- ===== CONTACT DETAILS ===== -->
    <div class="lg:col-span-5 flex flex-col gap-space-md">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-space-lg flex flex-col gap-space-md">
            <h2 class="font-headline-sm text-headline-sm text-primary font-normal">Get in touch</h2>

            <div class="flex items-start gap-space-md">
                <span class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">pin_drop</span>
                </span>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Office address</div>
                    <div class="font-title-sm text-title-sm text-on-surface font-semibold">@info.Address</div>
                    @if (!string.IsNullOrEmpty(info.City))
                    {
                        <div class="font-body-sm text-body-sm text-on-surface-variant">@info.City</div>
                    }
                    @if (!string.IsNullOrEmpty(info.MapLink))
                    {
                        <a class="inline-flex items-center gap-1 mt-1 font-label-md text-label-md text-secondary hover:underline font-semibold" href="@info.MapLink" target="_blank" rel="noopener noreferrer">
                            Get directions <span class="material-symbols-outlined text-[16px]">directions</span>
                        </a>
                    }
                </div>
            </div>

            <div class="flex items-start gap-space-md">
                <span class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
                </span>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Phone</div>
                    <a class="font-title-sm text-title-sm text-primary hover:text-secondary font-bold transition-colors" href="tel:@(info.Phone.Replace(" ", ""))">@info.Phone</a>
                </div>
            </div>

            <div class="flex items-start gap-space-md">
                <span class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">mark_email_read</span>
                </span>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Email</div>
                    <a class="block font-title-sm text-title-sm text-primary hover:underline font-semibold" href="mailto:@info.Email">@info.Email</a>
                    @if (!string.IsNullOrEmpty(info.SecondEmail))
                    {
                        <a class="block font-title-sm text-title-sm text-primary hover:underline font-semibold" href="mailto:@info.SecondEmail">@info.SecondEmail</a>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(info.OfficeHours) || !string.IsNullOrEmpty(info.WeekendHours))
            {
                <div class="flex items-start gap-space-md">
                    <span class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                        <span class="material-symbols-outlined text-[20px]">schedule</span>
                    </span>
                    <div>
                        <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Office hours</div>
                        @if (!string.IsNullOrEmpty(info.OfficeHours))
                        {
                            <div class="font-body-md text-body-md text-on-surface font-semibold">@info.OfficeHours</div>
                        }
                        @if (!string.IsNullOrEmpty(info.WeekendHours))
                        {
                            <div class="font-body-sm text-body-sm text-on-surface-variant">@info.WeekendHours</div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-space-lg flex items-start gap-space-md">
            <span class="material-symbols-outlined text-secondary text-[28px]">help</span>
            <div>
                <h3 class="font-title-md text-title-md text-primary font-semibold">Looking for a quick answer?</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Many common questions about donations and programmes are answered in our Help Centre.</p>
                <a asp-controller="HelpCentre" asp-action="Index" class="inline-flex items-center gap-1 mt-space-xs font-label-lg text-label-lg text-secondary hover:text-primary font-bold uppercase tracking-wider">
                    Visit Help Centre <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ===== MESSAGE FORM ===== -->
    <div class="lg:col-span-7">
        <div class="bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden">
            <div class="h-2 w-full bg-gradient-to-r from-primary via-primary-container to-secondary"></div>
            <div class="p-space-lg flex flex-col gap-space-md">

                @if (sentBy != null)
                {
                    <div class="bg-tertiary-fixed/30 p-space-md rounded-xl flex items-center gap-space-sm text-tertiary" role="status">
                        <span class="material-symbols-outlined text-[24px]">task_alt</span>
                        <div>
                            <h3 class="font-title-sm text-title-sm font-bold">Thank you, @sentBy! Your message has been sent.</h3>
                            <p class="font-body-sm text-body-sm">Our team will reply to your email as soon as possible.</p>
                        </div>
                    </div>
                }

                <div>
                    <h2 class="font-headline-sm text-headline-sm text-primary font-semibold">Send us a message</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Fields marked <span class="text-secondary">*</span> are required.</p>
                </div>

                <form asp-action="Index" method="post" class="flex flex-col gap-space-md" novalidate>
                    @* Spam bots ke liye chupa field (insaan ko nazar nahi aata) *@
                    <div class="hidden" aria-hidden="true">
                        <label for="website">Leave this empty</label>
                        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="FullName" class="@labelCls">Full name <span class="text-secondary">*</span></label>
                            <input asp-for="FullName" class="@inputCls" autocomplete="name" placeholder="Your full name" required maxlength="100" />
                            <span asp-validation-for="FullName" class="@errorCls"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Email" class="@labelCls">Email address <span class="text-secondary">*</span></label>
                            <input asp-for="Email" class="@inputCls" autocomplete="email" placeholder="you@@example.com" required maxlength="100" />
                            <span asp-validation-for="Email" class="@errorCls"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Phone" class="@labelCls">Phone <span class="text-outline font-normal">(optional)</span></label>
                            <input asp-for="Phone" class="@inputCls" autocomplete="tel" placeholder="+92 300 1234567" maxlength="30" />
                            <span asp-validation-for="Phone" class="@errorCls"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Subject" class="@labelCls">Subject <span class="text-secondary">*</span></label>
                            <input asp-for="Subject" class="@inputCls" placeholder="What is this about?" required maxlength="150" list="subjectIdeas" />
                            <datalist id="subjectIdeas">
                                <option value="Donation question"></option>
                                <option value="Corporate partnership"></option>
                                <option value="Volunteering"></option>
                                <option value="Register my NGO"></option>
                                <option value="Website problem"></option>
                            </datalist>
                            <span asp-validation-for="Subject" class="@errorCls"></span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Message" class="@labelCls">Message <span class="text-secondary">*</span></label>
                        <textarea asp-for="Message" class="@inputCls resize-y" rows="6" minlength="10" maxlength="2000" required
                                  placeholder="Write your message here..."></textarea>
                        <div class="flex justify-between gap-space-sm">
                            <span asp-validation-for="Message" class="@errorCls"></span>
                            <span class="font-label-sm text-label-sm text-outline ml-auto" id="msgCount">0 / 2000</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full md:w-auto md:self-start bg-secondary hover:bg-secondary-container text-on-secondary px-space-xl py-space-sm rounded-lg font-label-lg text-label-lg uppercase tracking-wider transition-colors shadow-md flex items-center justify-center gap-space-xs">
                        <span class="material-symbols-outlined text-[18px]">send</span> Send message
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
</section>

</div>

@section Scripts {
<script>
    // Message ke characters gin kar dikhao
    (function () {
        const box = document.getElementById('Message');
        const out = document.getElementById('msgCount');
        function update() { out.textContent = box.value.length + ' / 2000'; }
        box.addEventListener('input', update);
        update();
    })();

    // Browser khud check kare, aur pehli ghalat field par le jaye
    document.querySelector('form[novalidate]').addEventListener('submit', function (e) {
        if (!this.checkValidity()) {
            e.preventDefault();
            this.reportValidity();
        }
    });
</script>
}
