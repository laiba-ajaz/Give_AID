@{
    ViewData["Title"] = "Register / Log In";
    Layout = "_AuthLayout";
}

<div class="flex flex-col w-full max-w-[1360px] mx-auto py-space-md lg:py-space-xl">
<!-- Minimalist Brand Header Bar within Content Flow -->
<div class="flex items-center justify-between pb-space-lg mb-space-lg">
<a href="~/" class="flex items-center gap-space-sm" aria-label="Give-AID home">
<div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-surface shadow-sm">
<span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
</div>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg tracking-tight font-bold text-primary leading-none">
          Give<span class="text-secondary">-AID</span>
</span>
<span class="font-label-sm text-label-sm tracking-widest text-outline uppercase font-semibold mt-0.5">
          United for Welfare
        </span>
</div>
</a>
<div class="flex items-center gap-space-md">
<div class="hidden sm:flex items-center gap-1.5 px-3 py-1 bg-surface-container-high rounded-full text-primary font-label-md text-label-md">
<span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        Global Relief Audited • 2025/26 Cycle
      </div>
<a class="font-label-md text-label-md text-outline hover:text-primary transition-colors flex items-center gap-1" href="~/HelpCentre">
<span class="material-symbols-outlined text-[18px]">verified_user</span> Institutional Trust Center
      </a>
</div>
</div>
<!-- Main Split Two-Column Canvas -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
<!-- LEFT COLUMN: Editorial Photographic & Impact Showcase (5/12 cols) -->
<div class="lg:col-span-5 flex flex-col justify-between relative rounded-xl overflow-hidden bg-primary text-on-primary shadow-xl">
<!-- Background Image with Calibrated Editorial Gradient -->
<div class="absolute inset-0 z-0 bg-cover bg-center" data-alt="Warm atmospheric documentary photo of compassionate diverse community volunteers packaging dry food and medical aid in a sunlit welfare logistics depot with wood pallets and green foliage in background, cinematic natural lighting, teal tones with subtle warm highlights." style="background-image: url('/images/register-1.jpg')">
<!-- Deep Gradient Overlays for High Legibility -->
<div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-primary/50"></div>
<div class="absolute inset-0 bg-gradient-to-r from-primary/90 via-transparent to-primary/40"></div>
</div>
<!-- Foreground Content Container -->
<div class="relative z-10 p-space-lg lg:p-space-xl flex flex-col justify-between h-full space-y-space-xl">
<!-- Top Editorial Badging & Lead -->
<div class="space-y-space-md">
<div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-lowest/15 backdrop-blur-md rounded-full text-tertiary-fixed text-label-sm font-label-sm tracking-wider uppercase">
<span class="material-symbols-outlined text-[15px] text-secondary-fixed">public</span>
            Accredited Global Philanthropy
          </div>
<h2 class="font-headline-lg text-headline-lg lg:font-display-mobile lg:text-display-mobile text-on-primary font-normal leading-tight">
            Join a global network dedicated to human dignity.
          </h2>
<p class="font-body-md text-body-md text-surface-container-highest/90 max-w-md">
            Create an account to track your donations, receive verified impact reports, volunteer for local grassroots programmes, and mobilize your community.
          </p>
</div>
<!-- 3 Benefit Bullets with warm coral / teal accents -->
<div class="space-y-space-md py-space-sm">
<div class="flex items-start gap-space-md p-space-md rounded-lg bg-primary-container/40 backdrop-blur-sm shadow-sm">
<div class="flex-shrink-0 w-8 h-8 rounded-full bg-secondary text-on-secondary flex items-center justify-center shadow">
<span class="material-symbols-outlined text-[18px]">verified</span>
</div>
<div>
<h4 class="font-title-sm text-title-sm text-on-primary">Direct &amp; Verified Impact</h4>
<p class="font-body-sm text-body-sm text-surface-container-high/80 mt-0.5">
                100% transparent tracking of every dollar deployed to certified, audited NGOs.
              </p>
</div>
</div>
<div class="flex items-start gap-space-md p-space-md rounded-lg bg-primary-container/40 backdrop-blur-sm shadow-sm">
<div class="flex-shrink-0 w-8 h-8 rounded-full bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center shadow">
<span class="material-symbols-outlined text-[18px]">handshake</span>
</div>
<div>
<h4 class="font-title-sm text-title-sm text-on-primary">Participate in Field Programmes</h4>
<p class="font-body-sm text-body-sm text-surface-container-high/80 mt-0.5">
                Register for direct hands-on volunteering, mentoring circles, and educational relief workshops.
              </p>
</div>
</div>
<div class="flex items-start gap-space-md p-space-md rounded-lg bg-primary-container/40 backdrop-blur-sm shadow-sm">
<div class="flex-shrink-0 w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shadow">
<span class="material-symbols-outlined text-[18px]">groups_3</span>
</div>
<div>
<h4 class="font-title-sm text-title-sm text-on-primary">Double Your Reach</h4>
<p class="font-body-sm text-body-sm text-surface-container-high/80 mt-0.5">
                Instantly unlock corporate gift matching and organize private giving circles with team analytics.
              </p>
</div>
</div>
</div>
<!-- Volunteer Testimonial Card Overlay -->
<div class="p-space-md rounded-lg bg-surface-container-lowest/10 backdrop-blur-md shadow-lg">
<div class="flex items-center gap-3 mb-2">
<div class="w-10 h-10 rounded-full bg-cover bg-center overflow-hidden flex-shrink-0 shadow" data-alt="Portrait photo of a young female Asian tech professional smiling warmly in an office setting with natural light, wearing a simple navy linen shirt." style="background-image: url('/images/register-2.jpg')"></div>
<div>
<div class="font-title-sm text-title-sm text-on-primary">Amara Okafor</div>
<div class="font-label-sm text-label-sm text-primary-fixed-dim">Corporate CSR Lead &amp; Volunteer Coordinator</div>
</div>
</div>
<p class="font-body-sm text-body-sm text-surface-container italic text-on-primary/95">
            “Give-AID made it effortless for our tech company team to sponsor and mentor 120 rural students this year. True clarity from donor to recipient.”
          </p>
</div>
</div>
</div>
<!-- RIGHT COLUMN: Interactive High-Polish Registration Card (7/12 cols) -->
<div class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-md p-space-md sm:p-space-lg lg:p-space-xl flex flex-col justify-between">
<div>
<!-- Mode Switcher: Register vs Log In -->
<div class="flex items-center justify-between pb-space-md mb-space-lg">
<div class="inline-flex p-1 bg-surface-container rounded-lg">
<button class="px-space-md py-2 rounded-lg font-title-sm text-title-sm transition-all bg-primary text-on-primary shadow-sm flex items-center gap-2" id="tabRegister" type="button">
<span class="material-symbols-outlined text-[18px]">person_add</span>
              Register (New Member)
            </button>
<button class="px-space-md py-2 rounded-lg font-title-sm text-title-sm transition-all text-on-surface-variant hover:text-primary flex items-center gap-2" id="tabLogin" type="button">
<span class="material-symbols-outlined text-[18px]">login</span>
              Log In to Account
            </button>
</div>
<span class="hidden sm:inline-block font-label-md text-label-md text-outline">
            Step 1 of 1 • Instant Access
          </span>
</div>
<!-- Fast Social Sign-Up Alternatives -->
<div class="mb-space-lg">
<label class="block font-label-sm text-label-sm uppercase tracking-wider text-outline mb-2">Fast onboarding with single sign-on</label>
<div class="grid grid-cols-3 gap-3">
<button class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-colors font-title-sm text-title-sm text-on-surface" type="button">
<svg class="w-4 h-4" viewbox="0 0 24 24">
<path d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z" fill="#EA4335"></path>
<path d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z" fill="#4285F4"></path>
<path d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.1c0 2.8.7 5.4 1.9 7.8l3.7-3.1z" fill="#FBBC05"></path>
<path d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.7C3.7 20.4 7.5 23.5 12 23.5z" fill="#34A853"></path>
</svg>
<span class="text-body-sm font-body-sm">Google</span>
</button>
<button class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-colors font-title-sm text-title-sm text-on-surface" type="button">
<svg class="w-4 h-4 fill-current" viewbox="0 0 24 24">
<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.07 1.72-.94 2.74 1 .08 2.02-.49 2.64-1.24z"></path>
</svg>
<span class="text-body-sm font-body-sm">Apple</span>
</button>
<button class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container-high transition-colors font-title-sm text-title-sm text-on-surface" type="button">
<svg class="w-4 h-4 fill-[#0A66C2]" viewbox="0 0 24 24">
<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
</svg>
<span class="text-body-sm font-body-sm">LinkedIn</span>
</button>
</div>
<div class="flex items-center my-space-md">
<div class="flex-grow h-px bg-surface-container-highest"></div>
<span class="px-space-md font-label-sm text-label-sm text-outline tracking-wider uppercase" id="dividerText">Or register with institutional credentials</span>
<div class="flex-grow h-px bg-surface-container-highest"></div>
</div>
</div>
<!-- FORM CONTENT -->
<form class="space-y-space-lg" id="registerForm" method="post" asp-controller="Account" asp-action="Register" novalidate>
<!-- SECTION 1: Personal Details -->
<div class="space-y-space-sm">
<div class="flex items-center gap-2">
<span class="w-5 h-5 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-label-sm text-label-sm font-bold">1</span>
<h3 class="font-title-md text-title-md text-primary font-semibold">Personal details</h3>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-1">
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="fullName">
                  Full name <span class="text-secondary">*</span>
</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[18px]">person</span>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-3 py-2.5 rounded-lg shadow-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20" id="fullName" name="FullName" autocomplete="name" placeholder="e.g. Sophia Chen" required type="text"/>
</div>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="emailAddress">
                  Institutional / Personal email <span class="text-secondary">*</span>
</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[18px]">mail</span>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-3 py-2.5 rounded-lg shadow-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20" id="emailAddress" name="Email" autocomplete="email" placeholder="you@@example.org" required type="email"/>
</div>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="phoneNum">
                  Phone number <span class="text-outline text-label-sm">(for verification alerts)</span>
</label>
<div class="flex rounded-lg shadow-sm overflow-hidden bg-surface-container-lowest">
<select name="CountryCode" aria-label="Country code" class="bg-surface-container-low text-on-surface font-label-md text-label-md px-2.5 py-2.5 outline-none cursor-pointer">
<option value="+92">🇵🇰 +92</option>
<option value="+1">🇺🇸 +1</option>
<option value="+44">🇬🇧 +44</option>
<option value="+49">🇩🇪 +49</option>
<option value="+91">🇮🇳 +91</option>
<option value="+65">🇸🇬 +65</option>
</select>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-3 py-2.5 focus:outline-none" id="phoneNum" name="PhoneNumber" autocomplete="tel-national" placeholder="(555) 342-8901" type="tel"/>
</div>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="region">
                  City &amp; Geographic region
                </label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[18px]">location_on</span>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-3 py-2.5 rounded-lg shadow-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20" id="region" name="City" autocomplete="address-level2" placeholder="e.g. Karachi, Sindh" type="text"/>
</div>
</div>
</div>
</div>
<!-- SECTION 2: Professional & Affiliation Details -->
<div class="space-y-space-sm pt-2">
<div class="flex items-center gap-2">
<span class="w-5 h-5 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-label-sm text-label-sm font-bold">2</span>
<h3 class="font-title-md text-title-md text-primary font-semibold">Professional &amp; affiliation details</h3>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-1">
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="occupation">
                  Role / Occupation
                </label>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-3 py-2.5 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20" id="occupation" name="Occupation" autocomplete="organization-title" placeholder="e.g. Teacher, Engineer, Student" type="text"/>
</div>
<div>
<div class="flex items-center justify-between mb-1.5">
<label class="font-label-md text-label-md text-on-surface-variant" for="orgName">Organisation / Employer</label>
<span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded font-semibold">
<span class="material-symbols-outlined text-[13px]">published_with_changes</span> Match Eligible
                  </span>
</div>
<div class="relative">
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-3 py-2.5 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20" id="orgName" name="Organisation" autocomplete="organization" placeholder="Company, school or NGO" type="text"/>
<span id="orgCheck" class="hidden material-symbols-outlined absolute right-3 top-2.5 text-emerald-600 text-[20px]">check_circle</span>
</div>
</div>
</div>
</div>
<!-- SECTION 3: Account Security & Validation Indicators -->
<div class="space-y-space-sm pt-2">
<div class="flex items-center gap-2">
<span class="w-5 h-5 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-label-sm text-label-sm font-bold">3</span>
<h3 class="font-title-md text-title-md text-primary font-semibold">Account security</h3>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-1">
<!-- Password Field with Interactive Strength Meter -->
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="password">
                  Create master password <span class="text-secondary">*</span>
</label>
<div class="relative">
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-3 py-2.5 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20" id="password" name="Password" autocomplete="new-password" placeholder="Min. 8 characters" required type="password"/>
<button class="pw-toggle material-symbols-outlined absolute right-3 top-3 text-outline text-[18px] hover:text-primary" data-target="password" aria-label="Show password" type="button">visibility</button>
</div>
<!-- Password Strength Visual Bar -->
<div class="mt-2 space-y-1">
<div class="flex items-center justify-between font-label-sm text-label-sm">
<span class="text-outline">Entropy strength</span>
<span class="text-outline font-semibold flex items-center gap-1" id="pwStrengthLabel">
<span class="material-symbols-outlined text-[14px]">shield</span> <span id="pwStrengthText">Not set</span>
                    </span>
</div>
<div class="h-1.5 w-full bg-surface-container-highest rounded-full overflow-hidden flex gap-1" id="pwStrengthBars">
<div class="h-full w-1/4 rounded-full"></div>
<div class="h-full w-1/4 rounded-full"></div>
<div class="h-full w-1/4 rounded-full"></div>
<div class="h-full w-1/4 rounded-full"></div>
</div>
</div>
</div>
<!-- Confirm Password Field with Explicit Error State -->
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="confirmPassword">
                  Confirm master password <span class="text-secondary">*</span>
</label>
<div class="relative">
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-3 py-2.5 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20" id="confirmPassword" name="ConfirmPassword" autocomplete="new-password" placeholder="Re-enter password" required type="password"/>
<span class="hidden material-symbols-outlined absolute right-3 top-2.5 text-[20px]" id="confirmIcon">error</span>
</div>
<!-- Explicit Error Message Component (shown by JS) -->
<div class="hidden mt-2 items-start gap-1.5 p-2 rounded-lg bg-error-container text-on-error-container" id="registerError">
<span class="material-symbols-outlined text-[16px] flex-shrink-0 mt-0.5">warning</span>
<p class="font-label-sm text-label-sm leading-tight" id="registerErrorText">
<strong>Mismatch detected:</strong> Passwords must match exactly and contain at least 8 characters with 1 symbol.
                  </p>
</div>
</div>
</div>
</div>
<!-- Stewardship Terms & Privacy Checkbox -->
<div class="pt-2">
<label class="flex items-start gap-3 cursor-pointer select-none">
<input class="mt-1 w-4 h-4 rounded text-primary accent-primary cursor-pointer focus:ring-0" id="acceptTerms" name="AcceptTerms" value="true" type="checkbox"/>
<span class="font-body-sm text-body-sm text-on-surface-variant">
                I agree to the <a class="font-title-sm text-primary underline underline-offset-4 hover:text-secondary" href="#terms">Give-AID Terms of Welfare Stewardship</a>, the donor non-disclosure accord, and the <a class="font-title-sm text-primary underline underline-offset-4 hover:text-secondary" href="#privacy">Civic Privacy Code</a>.
              </span>
</label>
</div>
<!-- Primary Registration CTA Button -->
<div class="pt-2">
<button class="w-full py-3.5 px-space-lg bg-secondary hover:bg-secondary/90 text-on-secondary font-title-lg text-title-lg rounded-lg shadow-md transition-all flex items-center justify-center gap-2 group" type="submit">
<span>Create account</span>
<span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
<div class="flex items-center justify-center gap-2 mt-2 font-label-sm text-label-sm text-outline">
<span class="material-symbols-outlined text-[14px]">lock</span>
              Protected by 256-bit TLS encryption &amp; Verified Partner Ledger
            </div>
</div>
</form>
<!-- LOGIN FORM (shown when the "Log In to Account" tab is active) -->
<form class="hidden space-y-space-lg" id="loginForm" method="post" asp-controller="Account" asp-action="Login" novalidate>
<div class="space-y-space-sm">
<div class="flex items-center gap-2">
<span class="w-5 h-5 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-label-sm text-label-sm font-bold">
<span class="material-symbols-outlined text-[14px]">login</span>
</span>
<h3 class="font-title-md text-title-md text-primary font-semibold">Welcome back</h3>
</div>
<div class="grid grid-cols-1 gap-space-md pt-1">
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="loginEmail">
                  Email address <span class="text-secondary">*</span>
</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[18px]">mail</span>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-3 py-2.5 rounded-lg shadow-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20" id="loginEmail" name="Email" autocomplete="email" placeholder="you@@example.org" required type="email"/>
</div>
</div>
<div>
<div class="flex items-center justify-between mb-1.5">
<label class="font-label-md text-label-md text-on-surface-variant" for="loginPassword">Password <span class="text-secondary">*</span></label>
<a class="font-label-md text-label-md text-primary underline underline-offset-4 hover:text-secondary" href="~/HelpCentre">Forgot password?</a>
</div>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[18px]">lock</span>
<input class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-10 py-2.5 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20" id="loginPassword" name="Password" autocomplete="current-password" placeholder="Your password" required type="password"/>
<button class="pw-toggle material-symbols-outlined absolute right-3 top-3 text-outline text-[18px] hover:text-primary" data-target="loginPassword" aria-label="Show password" type="button">visibility</button>
</div>
</div>
<label class="flex items-center gap-3 cursor-pointer select-none">
<input class="w-4 h-4 rounded accent-primary cursor-pointer" name="RememberMe" value="true" type="checkbox"/>
<span class="font-body-sm text-body-sm text-on-surface-variant">Keep me signed in on this device</span>
</label>
</div>
@if (ViewBag.LoginError != null)
{
<div class="flex items-start gap-1.5 p-2 rounded-lg bg-error-container text-on-error-container">
<span class="material-symbols-outlined text-[16px] flex-shrink-0 mt-0.5">warning</span>
<p class="font-label-sm text-label-sm leading-tight">@ViewBag.LoginError</p>
</div>
}
<div class="hidden items-start gap-1.5 p-2 rounded-lg bg-error-container text-on-error-container" id="loginError">
<span class="material-symbols-outlined text-[16px] flex-shrink-0 mt-0.5">warning</span>
<p class="font-label-sm text-label-sm leading-tight">Please enter a valid email and your password.</p>
</div>
</div>
<div class="pt-2">
<button class="w-full py-3.5 px-space-lg bg-secondary hover:bg-secondary/90 text-on-secondary font-title-lg text-title-lg rounded-lg shadow-md transition-all flex items-center justify-center gap-2 group" type="submit">
<span>Log in</span>
<span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
</div>
</form>
</div>
<!-- Footer Switcher Link -->
<div class="pt-space-lg mt-space-lg text-center bg-surface-container-low -mx-space-md sm:-mx-space-lg lg:-mx-space-xl -mb-space-md sm:-mb-space-lg lg:-mb-space-xl p-space-md rounded-b-xl">
<span class="font-body-md text-body-md text-on-surface-variant" id="switchPrompt">
          Already have an account? 
        </span>
<a class="font-title-md text-title-md font-semibold text-primary hover:text-secondary transition-colors inline-flex items-center gap-1 ml-1 underline underline-offset-4" href="#login" id="switchLink">
          <span id="switchLinkText">Log In here</span> <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
</a>
</div>
</div>
</div>
<!-- Interactive Script for Tab Switching Demo & Live Correction -->
</div>

@section Scripts {
<script src="~/js/register.js" asp-append-version="true"></script>
}
