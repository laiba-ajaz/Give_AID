@model IEnumerable<Give_AID.Models.DonationHistoryItem>
@{
    ViewData["Title"] = "My Donation History";
}

<div class="flex flex-col w-full">
    <!-- Header banner -->
    <div class="w-full bg-surface-container-low py-space-lg">
        <div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-space-xs">
                <a class="hover:text-primary transition-colors" href="~/">Home</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <a class="hover:text-primary transition-colors" href="~/Donate">Donate</a>
                <span class="material-symbols-outlined text-[14px] text-secondary font-semibold">chevron_right</span>
                <span class="text-secondary font-bold">My Donations</span>
            </nav>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
                <div>
                    <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight font-medium">My Giving Journey &amp; Receipts</h1>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mt-space-xs">
                        Review your verified contributions, tax receipt records, and audited grassroots impact.
                    </p>
                </div>
                <a href="~/Donate" class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-secondary hover:bg-secondary-container text-on-secondary font-label-md text-label-md font-semibold rounded-lg shadow-sm transition-colors shrink-0">
                    <span class="material-symbols-outlined text-[18px]">favorite</span>
                    <span>Make a New Gift</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-[1440px] w-full mx-auto px-margin-mobile md:px-margin py-space-xl">
        @if (Model == null || !Model.Any())
        {
            <!-- Empty state -->
            <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-space-xl text-center flex flex-col items-center gap-space-md max-w-xl mx-auto my-space-lg">
                <div class="w-16 h-16 rounded-full bg-secondary/10 text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[36px]">volunteer_activism</span>
                </div>
                <div class="flex flex-col gap-1">
                    <h3 class="font-headline-sm text-headline-sm text-primary font-semibold">No donations recorded yet</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        You have not made any donations with this account yet. Your contributions will appear here with instant tax receipts once submitted.
                    </p>
                </div>
                <a href="~/Donate" class="mt-space-xs px-space-xl py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded-xl shadow-sm transition-colors">
                    Browse Causes &amp; Donate
                </a>
            </div>
        }
        else
        {
            <!-- Donations summary cards & table -->
            <div class="flex flex-col gap-space-lg">
                <!-- Summary Metrics Bar -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md">
                    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center gap-space-md">
                        <div class="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[26px]">receipt_long</span>
                        </div>
                        <div>
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Total Gifts</span>
                            <div class="font-headline-sm text-headline-sm text-primary font-bold">@Model.Count()</div>
                        </div>
                    </div>
                    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center gap-space-md">
                        <div class="w-12 h-12 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[26px]">payments</span>
                        </div>
                        <div>
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Total Contributed</span>
                            <div class="font-headline-sm text-headline-sm text-secondary font-bold">$@Model.Sum(x => x.TotalCharged).ToString("F2")</div>
                        </div>
                    </div>
                    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center gap-space-md">
                        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[26px]">verified</span>
                        </div>
                        <div>
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Tax Deductible (501c3)</span>
                            <div class="font-headline-sm text-headline-sm text-emerald-600 font-bold">100% Verified</div>
                        </div>
                    </div>
                </div>

                <!-- Ledger Table Card -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
                    <div class="p-space-md border-b border-surface-variant flex items-center justify-between">
                        <h2 class="font-title-md text-title-md text-primary font-semibold">Contributions History</h2>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Showing @Model.Count() records</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                                    <th class="py-space-sm px-space-md">Date</th>
                                    <th class="py-space-sm px-space-md">Allocated Cause</th>
                                    <th class="py-space-sm px-space-md">Amount</th>
                                    <th class="py-space-sm px-space-md">Frequency</th>
                                    <th class="py-space-sm px-space-md">Payment Info</th>
                                    <th class="py-space-sm px-space-md">Transaction ID</th>
                                    <th class="py-space-sm px-space-md">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-variant font-body-sm text-body-sm text-on-surface">
                                @foreach (var item in Model)
                                {
                                    <tr class="hover:bg-surface-container-low/50 transition-colors">
                                        <td class="py-space-md px-space-md whitespace-nowrap text-on-surface-variant">
                                            @item.Date.ToString("MMM dd, yyyy")
                                            <span class="block text-[11px] text-outline">@item.Date.ToString("hh:mm tt")</span>
                                        </td>
                                        <td class="py-space-md px-space-md font-semibold text-primary max-w-xs">
                                            @item.CauseName
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap">
                                            <span class="font-bold text-secondary text-title-sm">$@item.TotalCharged.ToString("F2")</span>
                                            @if (item.TotalCharged > item.Amount)
                                            {
                                                <span class="block text-[11px] text-on-surface-variant">(Includes 3% fee)</span>
                                            }
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap">
                                            <span class="px-2 py-0.5 rounded-full text-[12px] bg-surface-container-high text-primary font-medium">
                                                @item.Frequency
                                            </span>
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap text-on-surface-variant">
                                            <span class="inline-flex items-center gap-1 font-mono text-[12px]">
                                                <span class="material-symbols-outlined text-[16px]">credit_card</span>
                                                @item.PaymentMethod •••• @item.CardLast4
                                            </span>
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap font-mono text-[12px] text-primary font-bold">
                                            @item.TransactionId
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap">
                                            @if (item.Status == "Success")
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-emerald-500/10 text-emerald-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                    Success
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-surface-container-high text-on-surface-variant">
                                                    @item.Status
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
