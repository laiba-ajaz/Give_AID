@model List<Programme>
@{
    ViewData["Title"] = "Programmes & Events";

    var today = DateTime.Today;
    var selected = ViewBag.Selected as Programme;
    var ngoCount = ViewBag.NgoCount as int? ?? 0;
    var upcomingCount = Model.Count(p => !Give_AID.Controllers.ProgrammesController.IsFinished(p, today));

    // Filter chips: jin causes ke programmes maujood hain
    var causeChips = Model.Where(p => p.Cause != null)
        .GroupBy(p => p.DonationCausesID)
        .Select(g => new { Key = "c" + g.Key, Name = g.First().Cause!.CauseName, Count = g.Count() })
        .OrderBy(c => c.Name)
        .ToList();
}

@functions {
    static string DateText(Programme p) =>
        p.EndDate != null && p.EndDate.Value.Date != p.StartDate.Date
            ? (p.StartDate.Year == p.EndDate.Value.Year
                ? $"{p.StartDate:MMM dd} – {p.EndDate.Value:MMM dd, yyyy}"
                : $"{p.StartDate:MMM dd, yyyy} – {p.EndDate.Value:MMM dd, yyyy}")
            : p.StartDate.ToString("dddd, MMM dd, yyyy");

    static string Thumb(Programme p) => string.IsNullOrEmpty(p.ImagePath) ? CauseLook.DefaultImage(p.Cause?.CauseName) : p.ImagePath;

    static string Meta(Programme p) => DateText(p) + (string.IsNullOrEmpty(p.Location) ? "" : " • " + p.Location);
}

<div class="flex flex-col w-full">
<div class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
<!-- Breadcrumb navigation -->
<nav class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md mb-space-sm">
<a class="hover:text-primary transition-colors" href="~/">Home</a>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span class="text-primary font-semibold">Welfare Programmes &amp; Activities</span>
</nav>
<!-- Section Title & Narrative Intro -->
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md mb-space-lg">
<div class="max-w-2xl">
<div class="inline-flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-primary/10 text-primary font-label-sm text-label-sm uppercase tracking-wider mb-space-xs">
<span class="material-symbols-outlined text-[14px]">volunteer_activism</span>
            Grassroots Action Framework
          </div>
<h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Welfare Programmes &amp; Events</h1>
<p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">
            Programmes run by our partner NGOs for education, health care and specially challenged people. Volunteer your time or register your interest in an upcoming event.
          </p>
</div>
<!-- Live metrics bar (database se) -->
<div class="flex items-center gap-space-md sm:gap-space-lg bg-surface-container-lowest p-space-md rounded-xl shadow-sm shrink-0 self-start max-w-full">
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary font-semibold leading-none">@upcomingCount</span>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase mt-1">Upcoming</span>
</div>
<div class="w-px h-8 bg-surface-container-high"></div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-secondary font-semibold leading-none">@Model.Count</span>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase mt-1">Total Programmes</span>
</div>
<div class="w-px h-8 bg-surface-container-high"></div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary font-semibold leading-none">@ngoCount</span>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase mt-1">Partner NGOs</span>
</div>
</div>
</div>
<!-- Search & Filters -->
<div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col gap-space-md">
<div class="relative">
<span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
<input class="w-full pl-11 pr-space-md py-space-sm bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all" id="programmeSearch" name="q" placeholder="Search by programme, city or NGO name..." type="search"/>
</div>
<div class="flex flex-wrap items-center gap-space-xs">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mr-space-xs">Category:</span>
<button type="button" data-filter="all" class="filter-chip inline-flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-primary text-on-primary font-label-md text-label-md transition-all shadow-sm">
<span class="w-2 h-2 rounded-full bg-secondary-fixed"></span>
            All Programmes (@Model.Count)
          </button>
@foreach (var chip in causeChips)
{
<button type="button" data-filter="@chip.Key" class="filter-chip inline-flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-all">
            @chip.Name (@chip.Count)
          </button>
}
<div class="ml-auto flex items-center gap-space-xs text-outline font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[16px]">tune</span>
<button type="button" id="resetFilters" class="hover:text-primary">Reset filters</button>
</div>
</div>
</div>
</div>
</div>
<!-- Programme cards + interest form -->
<div class="w-full max-w-[1440px] mx-auto px-margin-mobile md:px-margin py-space-xl relative">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
<div class="@(Model.Count == 0 ? "lg:col-span-12" : "lg:col-span-7") flex flex-col gap-space-lg">
@if (Model.Count == 0)
{
<div class="bg-surface-container-low rounded-xl p-space-xl text-center flex flex-col items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[44px]">event_busy</span>
<h2 class="font-title-lg text-title-lg text-primary">No programmes yet</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">New programmes from our partner NGOs will be listed here. Meanwhile you can support a cause directly.</p>
<a href="~/Donate" class="mt-space-xs bg-secondary hover:bg-secondary-container text-on-secondary px-space-lg py-space-sm rounded-lg font-label-lg text-label-lg uppercase tracking-wider transition-colors">Donate now</a>
</div>
}
else
{
<div class="flex items-center justify-between">
<span class="font-title-sm text-title-sm text-primary">@upcomingCount upcoming · @(Model.Count - upcomingCount) completed</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Choose a programme to register your interest</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
@foreach (var p in Model)
{
    var isSelected = selected != null && selected.ProgrammeId == p.ProgrammeId;
    var finished = Give_AID.Controllers.ProgrammesController.IsFinished(p, today);
<div data-id="@p.ProgrammeId" data-category="@(p.Cause == null ? "" : "c" + p.DonationCausesID)" data-meta="@Meta(p)" data-thumb="@Thumb(p)"
     class="programme-card bg-surface-container-lowest rounded-xl @(isSelected ? "shadow-md ring-2 ring-secondary/30 relative" : "shadow-sm hover:shadow-md") p-space-md flex flex-col justify-between group transition-all duration-300">
@if (isSelected)
{
<div id="selectedRibbon" class="absolute -top-3 left-space-md bg-secondary text-on-secondary px-space-sm py-0.5 rounded font-label-sm text-label-sm shadow-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">edit_note</span>
              Selected for Registration
            </div>
}
<div>
<div class="relative w-full h-48 rounded-lg overflow-hidden mb-space-md mt-1 bg-surface-container">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 @(finished ? "grayscale-[40%]" : "")" src="@Thumb(p)" alt="@p.Title" loading="lazy"/>
<div class="absolute top-2 left-2 flex flex-wrap gap-1">
@if (p.Cause != null)
{
<span class="bg-primary/90 backdrop-blur-sm text-on-primary px-space-xs py-0.5 rounded font-label-sm text-label-sm tracking-wide">@p.Cause.CauseName</span>
}
@if (finished)
{
<span class="bg-surface-container-lowest/90 text-on-surface-variant font-semibold px-space-xs py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-0.5 shadow-sm">
<span class="material-symbols-outlined text-[13px]">task_alt</span> Completed
                  </span>
}
else if (p.StartDate <= today)
{
<span class="bg-secondary-container text-on-secondary-container font-semibold px-space-xs py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-0.5 shadow-sm">
<span class="material-symbols-outlined text-[13px]">play_circle</span> Happening now
                  </span>
}
</div>
</div>
<h2 class="programme-title font-headline-sm text-headline-sm text-primary tracking-tight font-semibold mb-space-xs group-hover:text-secondary transition-colors">@p.Title</h2>
@if (p.NGO != null)
{
<div class="flex items-center gap-space-xs mb-space-sm">
<span class="material-symbols-outlined text-secondary text-[16px]">verified</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">By @p.NGO.NGOName</span>
</div>
}
<div class="bg-surface-container-low rounded-lg p-space-xs mb-space-sm flex flex-col gap-1 text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-[16px] text-outline">calendar_today</span>
<span class="font-medium text-on-surface">@DateText(p)</span>
</div>
@if (!string.IsNullOrEmpty(p.Location))
{
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-[16px] text-outline">location_on</span>
<span>@p.Location</span>
</div>
}
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3 mb-space-md">@p.Description</p>
</div>
<div>
@if (finished)
{
<a href="@Url.Action("Index", "PhotoGallery")" class="w-full py-space-sm px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface-variant font-label-lg text-label-lg flex items-center justify-center gap-space-xs transition-all">
<span class="material-symbols-outlined text-[18px]">photo_library</span>
<span>See photos in gallery</span>
</a>
<button type="button" class="interest-btn hidden" aria-hidden="true" tabindex="-1"></button>
}
else
{
<button type="button" class="interest-btn w-full py-space-sm px-space-md rounded @(isSelected ? "bg-secondary hover:bg-secondary-container text-on-secondary" : "bg-primary hover:bg-primary-container text-on-primary") font-label-lg text-label-lg flex items-center justify-center gap-space-xs shadow-sm transition-all">
<span>I'm interested</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
}
</div>
</div>
}
</div>
<div class="bg-surface-container-low rounded-xl p-space-md flex flex-col sm:flex-row items-center justify-between gap-space-md">
<div class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
<span>Showing <strong class="text-primary" id="shownCount">1 – @Model.Count</strong> of @Model.Count programmes</span>
</div>
</div>
}
</div>
<!-- Slide-in Modal Drawer / Interactive Registration Panel (Span 5) -->
@if (selected != null)
{
<div class="lg:col-span-5 sticky top-24" id="interestPanel">
<div class="bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden">
<!-- Drawer Header -->
<div class="bg-primary text-on-primary px-space-lg py-space-md flex items-center justify-between">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-[20px] text-secondary-fixed">assignment_turned_in</span>
<div>
<h3 class="font-title-md text-title-md font-semibold text-on-primary leading-tight">Register Your Interest</h3>
<span class="font-label-sm text-label-sm text-on-primary-container">Official Welfare Coordinator Dispatch</span>
</div>
</div>
<button type="button" id="clearInterest" aria-label="Clear form" class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center text-on-primary hover:bg-surface-container hover:text-primary transition-colors">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<!-- Active Programme Selected Context Banner -->
<div class="p-space-md bg-surface-container-low flex items-center gap-space-md">
<div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
<img id="selThumb" alt="" class="w-full h-full object-cover" src="@Thumb(selected)"/>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-sm text-label-sm text-secondary uppercase font-semibold">Active Selection</span>
<span class="font-title-sm text-title-sm text-primary font-bold truncate" id="selTitle">@selected.Title</span>
<span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
<span class="material-symbols-outlined text-[14px]">event</span> <span id="selMeta">@Meta(selected)</span>
              </span>
</div>
</div>
<!-- Registration Form Body -->
<form class="p-space-lg flex flex-col gap-space-md" id="interestForm" method="post" asp-controller="Programmes" asp-action="Interest" novalidate>
<input type="hidden" name="ProgrammeId" id="selProgrammeId" value="@selected.ProgrammeId"/>
<!-- Full Name -->
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piName">Full Name *</label>
<div class="relative">
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piName" name="FullName" autocomplete="name" placeholder="Your full name" required type="text"/>
<span class="valid-icon hidden material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-primary text-[18px]">check_circle</span>
</div>
</div>
<!-- Contact Grid (Email & Phone) -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piEmail">Email Address *</label>
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piEmail" name="Email" autocomplete="email" placeholder="you@@example.com" required type="email"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piPhone">Phone Number *</label>
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piPhone" name="Phone" autocomplete="tel" placeholder="+92 300 1234567" required type="tel"/>
</div>
</div>
<!-- Participation Role Radios -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface font-semibold">How would you like to participate?</label>
<div class="grid grid-cols-1 gap-2">
<!-- Option 1: Checked -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="Volunteer" class="w-4 h-4 accent-primary shrink-0 cursor-pointer" checked/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-primary font-bold">Volunteer In-Person</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Help on the day at the programme location.</span>
</div>
</label>
<!-- Option 2 -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="Sponsor" class="w-4 h-4 accent-primary shrink-0 cursor-pointer"/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-on-surface font-semibold">Sponsor Materials</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Fund supplies such as books, medicines or learning kits.</span>
</div>
</label>
<!-- Option 3 -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="OnlineMentor" class="w-4 h-4 accent-primary shrink-0 cursor-pointer"/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-on-surface font-semibold">Remote Support</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Help with planning, outreach or online tasks from home.</span>
</div>
</label>
</div>
</div>
<!-- Notes & Background -->
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piMessage">Personal Message / Relevant Experience</label>
<textarea class="w-full p-space-md rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary resize-none" id="piMessage" name="Message" maxlength="1000" placeholder="Tell the coordinator about your skills or why you want to join..." rows="3"></textarea>
</div>
<!-- Consent Checkbox -->
<label class="flex items-start gap-space-xs cursor-pointer">
<input type="checkbox" id="piConsent" name="AgreeBackgroundCheck" value="true" class="w-4 h-4 accent-primary shrink-0 mt-0.5 cursor-pointer"/>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">
                I agree to undergo the standard background check required for programmes interacting with youth and vulnerable communities.
              </span>
</label>
<!-- Submit Button (Warm Coral) -->
<p id="interestError" class="hidden font-label-md text-label-md text-error"></p>
<button type="submit" class="w-full py-space-md px-space-lg rounded-lg bg-secondary hover:bg-secondary-container text-on-secondary font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-xs uppercase tracking-wider shadow-md hover:shadow transition-all">
<span class="material-symbols-outlined text-[20px]">send</span>
<span>Send my interest</span>
</button>
<!-- Embedded Confirmation State Preview Card -->
<div id="interestSuccess" class="hidden mt-space-xs p-space-md rounded-lg bg-tertiary-fixed/30 items-start gap-space-sm">
<span class="material-symbols-outlined text-tertiary text-[22px] shrink-0 mt-0.5">check_circle</span>
<div class="flex flex-col">
<span class="font-title-sm text-title-sm text-tertiary font-bold">Interest Sent Successfully!</span>
<p class="font-body-sm text-body-sm text-on-surface-variant text-[12px] mt-0.5">
                  The programme coordinator will contact you by email with the next steps.
                </p>
</div>
</div>
</form>
</div>
</div>
}
</div>
</div>
<!-- Corporate / Alliance Welfare Banner -->
<div class="w-full bg-surface-container-high py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
<div class="flex flex-col md:flex-row items-center justify-between gap-space-lg bg-surface-container-lowest rounded-2xl p-space-xl shadow-sm">
<div class="flex items-start gap-space-md max-w-2xl">
<div class="w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[28px]">handshake</span>
</div>
<div class="flex flex-col">
<h3 class="font-headline-sm text-headline-sm text-primary font-semibold">Organize a Corporate Giving Day or Host a Programme</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              Give-AID partners with enterprise CSR teams to structure measurable employee engagement events, equipment grants, and verified local field visits.
            </p>
</div>
</div>
<div class="flex flex-wrap items-center gap-space-sm shrink-0">
<a href="~/contact-us?subject=Corporate%20partnership" class="px-space-lg py-space-sm rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg transition-colors">
            Inquire for Enterprise
          </a>
<button type="button" class="px-space-lg py-space-sm rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-lg text-label-lg transition-colors">
            Download NGO Guidebook
          </button>
</div>
</div>
</div>
</div>
</div>

@section Scripts {
@if (Model.Count > 0)
{
<script src="~/js/programmes.js" asp-append-version="true"></script>
}
}
