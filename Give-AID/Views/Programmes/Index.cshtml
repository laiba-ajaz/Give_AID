<!-- Full Name -->
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piName">Full Name *</label>
<div class="relative">
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piName" name="FullName" autocomplete="name" placeholder="Your full name" required type="text"/>
<span class="valid-icon hidden material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-primary text-[18px]">check_circle</span>
</div>
</div>
<!-- Contact Grid (Email & Phone) -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piEmail">Email Address *</label>
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piEmail" name="Email" autocomplete="email" placeholder="you@@example.com" required type="email"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piPhone">Phone Number *</label>
<input class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" id="piPhone" name="Phone" autocomplete="tel" placeholder="+92 300 1234567" required type="tel"/>
</div>
</div>
<!-- Participation Role Radios -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface font-semibold">How would you like to participate?</label>
<div class="grid grid-cols-1 gap-2">
<!-- Option 1: Checked -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="Volunteer" class="w-4 h-4 accent-primary shrink-0 cursor-pointer" checked/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-primary font-bold">Volunteer In-Person</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Be present at East Valley Community Center for hands-on mentoring.</span>
</div>
</label>
<!-- Option 2 -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="Sponsor" class="w-4 h-4 accent-primary shrink-0 cursor-pointer"/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-on-surface font-semibold">Sponsor Materials</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Fund 1 or more Arduino/Raspberry Pi learner kits ($65 each).</span>
</div>
</label>
<!-- Option 3 -->
<label class="flex items-center gap-space-sm p-space-sm rounded-lg hover:bg-surface-container-low has-[:checked]:bg-surface-container-low cursor-pointer transition-colors">
<input type="radio" name="ParticipationRole" value="OnlineMentor" class="w-4 h-4 accent-primary shrink-0 cursor-pointer"/>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-on-surface font-semibold">Online Mentor</span>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">Review weekly code submissions remotely via GitHub classroom.</span>
</div>
</label>
</div>
</div>
<!-- Notes & Background -->
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="piMessage">Personal Message / Relevant Experience</label>
<textarea class="w-full p-space-md rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary resize-none" id="piMessage" name="Message" maxlength="1000" placeholder="Tell the coordinator about your skills or why you want to join..." rows="3"></textarea>
</div>
<!-- Consent Checkbox -->
<label class="flex items-start gap-space-xs cursor-pointer">
<input type="checkbox" id="piConsent" name="AgreeBackgroundCheck" value="true" class="w-4 h-4 accent-primary shrink-0 mt-0.5 cursor-pointer"/>
<span class="font-body-sm text-body-sm text-on-surface-variant text-[12px] leading-tight">
                I agree to undergo the standard background check required for programmes interacting with youth and vulnerable communities.
              </span>
</label>
<!-- Submit Button (Warm Coral) -->
<p id="interestError" class="hidden font-label-md text-label-md text-error"></p>
<button type="submit" class="w-full py-space-md px-space-lg rounded-lg bg-secondary hover:bg-secondary-container text-on-secondary font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-xs uppercase tracking-wider shadow-md hover:shadow transition-all">
<span class="material-symbols-outlined text-[20px]">send</span>
<span>Send my interest</span>
</button>
<!-- Embedded Confirmation State Preview Card -->
<div id="interestSuccess" class="hidden mt-space-xs p-space-md rounded-lg bg-tertiary-fixed/30 items-start gap-space-sm">
<span class="material-symbols-outlined text-tertiary text-[22px] shrink-0 mt-0.5">check_circle</span>
<div class="flex flex-col">
<span class="font-title-sm text-title-sm text-tertiary font-bold">Interest Sent Successfully!</span>
<p class="font-body-sm text-body-sm text-on-surface-variant text-[12px] mt-0.5">
                  You'll receive event logistics, background clearance links, and orientation materials from coordinator Sarah Lin within 24 hours.
                </p>
</div>
</div>
</form>
</div>
</div>
</div>
</div>
<!-- Corporate / Alliance Welfare Banner -->
<div class="w-full bg-surface-container-high py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin">
<div class="flex flex-col md:flex-row items-center justify-between gap-space-lg bg-surface-container-lowest rounded-2xl p-space-xl shadow-sm">
<div class="flex items-start gap-space-md max-w-2xl">
<div class="w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[28px]">handshake</span>
</div>
<div class="flex flex-col">
<h3 class="font-headline-sm text-headline-sm text-primary font-semibold">Organize a Corporate Giving Day or Host a Programme</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              Give-AID partners with enterprise CSR teams to structure measurable employee engagement events, equipment grants, and verified local field visits.
            </p>
</div>
</div>
<div class="flex flex-wrap items-center gap-space-sm shrink-0">
<a href="~/HelpCentre#contact" class="px-space-lg py-space-sm rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg transition-colors">
            Inquire for Enterprise
          </a>
<button type="button" class="px-space-lg py-space-sm rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-lg text-label-lg transition-colors">
            Download NGO Guidebook
          </button>
</div>
</div>
</div>
</div>
</div>

@section Scripts {
<script src="~/js/programmes.js" asp-append-version="true"></script>
}
