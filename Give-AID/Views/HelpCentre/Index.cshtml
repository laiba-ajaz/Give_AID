<!-- Documentation Callout -->
<div class="bg-primary/5 rounded-xl p-space-md flex items-center justify-between gap-space-md">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[28px]">description</span>
<div>
<h4 class="font-title-sm text-title-sm text-primary font-semibold">Need comprehensive financial audits?</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant">Download our complete 2024 Welfare Impact &amp; Transparency Whitepaper.</p>
</div>
</div>
<a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary font-semibold hover:text-secondary shrink-0 transition-colors" href="#">
<span>View Audit PDF</span>
<span class="material-symbols-outlined text-[16px]">north_east</span>
</a>
</div>
</div>
<!-- Right Column: "Raise a Query" Support Card (5 Cols) -->
<div class="lg:col-span-5 scroll-mt-28" id="raise-query">
<div class="bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden relative">
<!-- Accent Top Bar -->
<div class="h-2 w-full bg-gradient-to-r from-primary via-primary-container to-secondary"></div>
<div class="p-space-lg flex flex-col gap-space-md">
<div>
<div class="inline-flex items-center gap-1 text-secondary font-label-sm text-label-sm uppercase tracking-widest font-bold mb-1">
<span class="material-symbols-outlined text-[14px]">support_agent</span>
                  Priority Dispatch Desk
                </div>
<h3 class="font-headline-sm text-headline-sm text-primary font-semibold">
                  Can't find what you're looking for? Raise a Direct Query
                </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                  Our welfare support staff typically responds within 3 hours.
                </p>
</div>
@if (querySent != null)
{
<div class="bg-tertiary-fixed/30 p-space-md rounded-xl flex items-start gap-space-sm text-tertiary" role="status">
<span class="material-symbols-outlined text-[24px]">task_alt</span>
<div>
<h4 class="font-title-sm text-title-sm font-bold">Query received – your reference is @querySent</h4>
<p class="font-body-sm text-body-sm">Keep this number. You can check our reply any time on the tracking page using this number and @querySentEmail.</p>
<a class="inline-flex items-center gap-1 mt-1 font-label-md text-label-md font-bold hover:underline" asp-action="Track" asp-route-reference="@querySent">
                    Track this query <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</a>
</div>
</div>
}
@if (queryError != null)
{
<div class="bg-error-container p-space-md rounded-xl flex items-center gap-space-sm text-on-error-container" role="alert">
<span class="material-symbols-outlined text-[22px]">error</span>
<p class="font-body-sm text-body-sm">@queryError</p>
</div>
}
<!-- Interactive Form -->
<form class="flex flex-col gap-space-md" id="supportQueryForm" method="post" asp-controller="HelpCentre" asp-action="Query">
<!-- Full Name Field -->
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="fullName">
                    Full Name <span class="text-secondary">*</span>
</label>
<div class="relative">
<input class="w-full bg-surface-container-low text-on-surface px-space-md py-space-sm rounded-lg font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" id="fullName" name="FullName" autocomplete="name" placeholder="Your full name" minlength="2" maxlength="100" required type="text" value="@queryName"/>
<span class="material-symbols-outlined absolute right-3 top-3 text-[18px] text-outline">badge</span>
</div>
</div>
<!-- Email Address Field -->
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="emailAddress">
                    Email Address <span class="text-secondary">*</span>
</label>
<div class="relative">
<input class="w-full bg-surface-container-low text-on-surface px-space-md py-space-sm rounded-lg font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" id="emailAddress" name="Email" autocomplete="email" placeholder="you@@example.com" maxlength="100" required type="email" value="@queryEmail"/>
<span class="material-symbols-outlined absolute right-3 top-3 text-[18px] text-outline">mail</span>
</div>
</div>
<!-- Topic Dropdown -->
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="topicSelect">
                    Inquiry Topic <span class="text-secondary">*</span>
</label>
<div class="relative">
<select class="w-full appearance-none bg-surface-container-low text-on-surface px-space-md py-space-sm rounded-lg font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer" id="topicSelect" name="Topic" required>
<option selected="" value="donation">Donation &amp; Tax Inquiries</option>
<option value="volunteer">Volunteer Verification</option>
<option value="corporate">Corporate Partnership</option>
<option value="technical">Technical Support</option>
<option value="issue">Report an Issue / Fraud Alert</option>
</select>
<span class="material-symbols-outlined absolute right-3 top-3 text-[20px] text-outline pointer-events-none">expand_more</span>
</div>
</div>
<!-- Urgent Priority Toggle Checkbox -->
<div class="bg-surface-container-low p-space-sm rounded-lg flex items-start gap-space-sm">
<input class="mt-1 w-4 h-4 rounded text-secondary focus:ring-secondary cursor-pointer" id="urgentToggle" name="IsUrgent" value="true" type="checkbox"/>
<label class="cursor-pointer" for="urgentToggle">
<div class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1">
<span>Mark as urgent</span>
<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-secondary-fixed text-on-secondary-fixed font-bold uppercase tracking-wider">Priority SLA</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">For active disaster events or matching deadlines within 24 hours.</p>
</label>
</div>
<!-- Message Box -->
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="messageBox">
                    Detailed Message <span class="text-secondary">*</span>
</label>
<textarea class="w-full bg-surface-container-low text-on-surface px-space-md py-space-sm rounded-lg font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all resize-none" id="messageBox" name="Message" minlength="10" maxlength="2000" placeholder="Describe your inquiry or request in detail..." required="" rows="4"></textarea>
</div>
<!-- Submit Button -->
<button class="w-full bg-secondary hover:bg-secondary-container text-on-secondary py-space-sm rounded-lg font-label-lg text-label-lg uppercase tracking-wider transition-colors shadow-md flex items-center justify-center gap-space-xs" id="submitQueryBtn" type="submit">
<span class="material-symbols-outlined text-[18px]">send</span>
<span>Submit Query</span>
</button>
<!-- SLA Pledge & Confirmation -->
<div class="pt-space-xs flex items-center justify-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm text-center">
<span class="material-symbols-outlined text-[16px] text-tertiary">schedule</span>
<span>Official response SLA: Under 4 business hours.</span>
</div>
<a class="self-center inline-flex items-center gap-1 font-label-md text-label-md text-secondary hover:text-primary font-bold" asp-action="Track">
                  Already raised a query? Track it here <span class="material-symbols-outlined text-[16px]">manage_search</span>
</a>
</form>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Section 3: Contact Us Section (Full width split layout) -->
<section id="contact" class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1320px] mx-auto px-margin-mobile md:px-margin">
<div class="mb-space-lg">
<span class="font-label-md text-label-md text-secondary uppercase tracking-widest block">Direct Human Access</span>
<h2 class="font-headline-lg text-headline-lg text-primary font-medium">Connect With Our Global Operations</h2>
</div>
<div class="bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">
<!-- Left: Interactive Map Graphic Viewport -->
<div class="lg:col-span-6 relative min-h-[380px] lg:min-h-full flex flex-col justify-between p-space-lg overflow-hidden">
<!-- Google Maps static pipeline div using data-location -->
<div class="absolute inset-0 w-full h-full bg-cover bg-center brightness-[0.95]" data-location="240 Welfare Way, San Francisco, CA 94107" style="background-image: url('/images/help-28.png')"></div>
<!-- Editorial Scrim Overlay for Contrast -->
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/30 to-transparent"></div>
<!-- Top Badge on Map -->
<div class="relative z-10 self-start">
<span class="inline-flex items-center gap-1.5 px-space-md py-space-xs rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-primary font-label-md text-label-md shadow-md">
<span class="material-symbols-outlined text-secondary text-[18px]">location_on</span>
              San Francisco Headquarters
            </span>
</div>
<!-- Floating Pin Card Overlay inside Map -->
<div class="relative z-10 bg-surface-container-lowest/95 backdrop-blur-md rounded-xl p-space-md shadow-lg max-w-sm">
<div class="flex items-start gap-space-sm">
<div class="w-9 h-9 rounded-full bg-secondary/10 flex items-center justify-center text-secondary shrink-0">
<span class="material-symbols-outlined text-[20px]">corporate_fare</span>
</div>
<div>
<h4 class="font-title-sm text-title-sm text-primary font-bold">Give-AID Global Welfare HQ</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant">@contact.Address<br/>@contact.City</p>
@if (!string.IsNullOrEmpty(contact.MapLink))
{
<div class="mt-space-xs flex items-center gap-space-md">
<a class="inline-flex items-center gap-1 font-label-sm text-label-sm text-secondary hover:underline font-semibold" href="@contact.MapLink" rel="noopener noreferrer" target="_blank">
<span>Get Directions</span>
<span class="material-symbols-outlined text-[14px]">directions</span>
</a>
</div>
}
</div>
</div>
</div>
</div>
<!-- Right: Structured Contact Protocol & Operational Details -->
<div class="lg:col-span-6 p-space-lg lg:p-space-xl flex flex-col justify-between gap-space-md">
<div class="flex flex-col gap-space-md">
<!-- Live Chat Status Banner -->
<div class="bg-tertiary-fixed/30 rounded-xl p-space-md flex items-center justify-between gap-space-sm">
<div class="flex items-center gap-space-sm">
<div class="relative flex items-center justify-center">
<span class="hidden w-3 h-3 rounded-full bg-emerald-500 animate-ping absolute" data-chat-ping></span>
<span class="w-3 h-3 rounded-full bg-outline relative" data-chat-dot></span>
</div>
<div>
<div class="font-label-md text-label-md text-tertiary font-bold tracking-wide uppercase" data-chat-banner>Live Chat</div>
<div class="font-body-sm text-body-sm text-on-tertiary-fixed-variant" data-chat-sub>Chat with our support team.</div>
</div>
</div>
<button type="button" class="bg-tertiary text-on-tertiary hover:bg-tertiary-container px-space-md py-1.5 rounded-full font-label-sm text-label-sm uppercase tracking-wider transition-colors shrink-0 shadow-sm flex items-center gap-1" id="openLiveChatBtn" data-open-chat>
<span class="material-symbols-outlined text-[16px]">chat</span>
<span>Launch Chat</span>
</button>
</div>
<!-- Structured Detail List -->
<div class="flex flex-col gap-space-md pt-space-xs">
<!-- Address -->
<div class="flex items-start gap-space-md">
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-[20px]">pin_drop</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Physical Campus</div>
<div class="font-title-sm text-title-sm text-on-surface font-semibold">@contact.Address</div>
<div class="font-body-sm text-body-sm text-on-surface-variant">@contact.City</div>
</div>
</div>
<!-- Phone Inquiries -->
<div class="flex items-start gap-space-md">
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Direct Hotline (Toll-Free)</div>
<a class="font-title-sm text-title-sm text-primary hover:text-secondary font-bold transition-colors" href="tel:@(contact.Phone.Replace(" ", ""))">
                    @contact.Phone
                  </a>
<div class="font-body-sm text-body-sm text-on-surface-variant">Multi-lingual support available in English, Spanish, and French.</div>
</div>
</div>
<!-- Email Addresses -->
<div class="flex items-start gap-space-md">
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-[20px]">mark_email_read</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Electronic Inquiries</div>
<div class="flex flex-wrap gap-x-space-md gap-y-1">
<a class="font-title-sm text-title-sm text-primary hover:underline font-semibold" href="mailto:@contact.Email">
                      @contact.Email
                    </a>
@if (!string.IsNullOrEmpty(contact.SecondEmail))
{
<span class="text-outline">•</span>
<a class="font-title-sm text-title-sm text-primary hover:underline font-semibold" href="mailto:@contact.SecondEmail">
                      @contact.SecondEmail
                    </a>
}
</div>
<a class="inline-flex items-center gap-1 mt-1 font-label-md text-label-md text-secondary hover:text-primary font-bold" asp-controller="ContactUs" asp-action="Index">
                    Or send us a message <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                  </a>
</div>
</div>
<!-- Operating Hours -->
<div class="flex items-start gap-space-md">
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-[20px]">timelapse</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Operational Hours</div>
<div class="font-body-md text-body-md text-on-surface font-semibold">
                    @contact.OfficeHours
                  </div>
<div class="font-body-sm text-body-sm text-on-surface-variant">
                    @contact.WeekendHours
                  </div>
</div>
</div>
</div>
</div>
<!-- Bottom Security Badge -->
<div class="pt-space-md flex items-center gap-space-sm bg-surface-container-low p-space-sm rounded-lg">
<span class="material-symbols-outlined text-primary text-[20px]">encrypted</span>
<p class="font-body-sm text-body-sm text-on-surface-variant">
              All communications and donor records are protected by 256-bit encryption in compliance with SOC-2 non-profit security standards.
            </p>
</div>
</div>
</div>
</div>
</section>
<!-- Interactive Script for FAQ Accordions, Live Chat, and Form Submission -->
</div>

<partial name="_ChatWidget" />

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
      // FAQ Accordion Logic
      const faqItems = document.querySelectorAll('.faq-item');
      faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const iconWrapper = item.querySelector('.faq-icon-wrapper');

        trigger.addEventListener('click', () => {
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          // Close all other accordions for clean single view
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              const otherTrigger = otherItem.querySelector('.faq-trigger');
              const otherContent = otherItem.querySelector('.faq-content');
              const otherIcon = otherItem.querySelector('.faq-icon-wrapper');
              
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherContent.classList.add('hidden');
              otherIcon.classList.remove('rotate-180', 'bg-primary-container', 'text-on-primary');
              otherIcon.classList.add('bg-surface-container', 'text-on-surface-variant');
              otherItem.classList.remove('shadow-md');
              otherItem.classList.add('shadow-sm');
            }
          });

          // Toggle current
          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            content.classList.add('hidden');
            iconWrapper.classList.remove('rotate-180', 'bg-primary-container', 'text-on-primary');
            iconWrapper.classList.add('bg-surface-container', 'text-on-surface-variant');
            item.classList.remove('shadow-md');
            item.classList.add('shadow-sm');
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            content.classList.remove('hidden');
            iconWrapper.classList.add('rotate-180', 'bg-primary-container', 'text-on-primary');
            iconWrapper.classList.remove('bg-surface-container', 'text-on-surface-variant');
            item.classList.add('shadow-md');
            item.classList.remove('shadow-sm');
          }
        });
      });

      // Filter Pill Quick Action
      const pills = document.querySelectorAll('.topic-pill');
      const searchInput = document.getElementById('faqSearchInput');
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          searchInput.value = pill.textContent.trim();
          searchInput.focus();
        });
      });

      // FAQ search — filter questions by keyword
      // Matches on word stems so "Tax Deductibility" finds "tax-deductible".
      const noResults = document.createElement('p');
      noResults.className = 'hidden font-body-md text-body-md text-on-surface-variant p-space-md rounded-lg bg-surface-container-low';
      noResults.textContent = 'No matching questions found. Use the "Raise a Query" form and our team will help you.';
      faqItems[faqItems.length - 1].after(noResults);

      function filterFaqs() {
        const stems = searchInput.value.toLowerCase().split(/[^a-z0-9]+/)
          .filter(w => w.length >= 3).map(w => w.slice(0, 5));
        let shown = 0;
        faqItems.forEach(item => {
          const text = item.textContent.toLowerCase();
          const match = stems.length === 0 || stems.some(s => text.includes(s));
          item.classList.toggle('hidden', !match);
          if (match) shown++;
        });
        noResults.classList.toggle('hidden', shown > 0);
      }
      searchInput.addEventListener('input', filterFaqs);
      const faqSearchButton = document.getElementById('faqSearchButton');
      if (faqSearchButton) faqSearchButton.addEventListener('click', filterFaqs);
      pills.forEach(pill => pill.addEventListener('click', filterFaqs));

      // Raise a Query — browser check kare, phir server par bhejo (do baar click se do queries na banein)
      const queryForm = document.getElementById('supportQueryForm');
      queryForm.addEventListener('submit', (e) => {
        if (!queryForm.checkValidity()) {
          e.preventDefault();
          queryForm.reportValidity();
          return;
        }
        const submitBtn = document.getElementById('submitQueryBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Sending...</span>';
      });

    });
  </script>
<script src="~/js/chat.js" asp-append-version="true"></script>
}
