<!-- FAQ 1: EXPANDED STATE -->
<div class="faq-item bg-surface-container-lowest rounded-xl shadow-md overflow-hidden transition-all duration-300">
<button aria-expanded="true" class="faq-trigger w-full px-space-lg py-space-lg text-left flex items-start justify-between gap-space-sm bg-surface-container-lowest hover:bg-surface-container-low transition-colors">
<div class="flex items-center gap-space-sm">
<span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center font-label-md text-label-md font-bold shrink-0">01</span>
<span class="font-title-md text-title-md text-primary font-semibold">How does Give-AID verify that NGOs are legitimate?</span>
</div>
<div class="faq-icon-wrapper w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center shrink-0 transition-transform duration-300 rotate-180">
<span class="material-symbols-outlined text-[20px]">keyboard_arrow_down</span>
</div>
</button>
<div class="faq-content px-space-lg pb-space-lg pt-space-xs">
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                Every participating NGO undergoes our rigorous 5-stage Welfare Audit before launching any fundraising campaign. We inspect registered non-profit status, verified government tax filings (501(c)(3) or national equivalent), audited financial records, on-the-ground project evidence, and background checks on leadership. Less than 18% of applicant organizations meet our transparency benchmarks.
              </p>
<!-- Micro Verification Checklist Visual -->
<div class="mt-space-md grid grid-cols-1 sm:grid-cols-3 gap-space-xs bg-surface-container-low p-space-sm rounded-lg">
<div class="flex items-center gap-1.5 font-label-sm text-label-sm text-tertiary">
<span class="material-symbols-outlined text-[16px] text-tertiary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
