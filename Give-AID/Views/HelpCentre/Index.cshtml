@inject Give_AID.Data.AppDBContext Db
@{
    ViewData["Title"] = "Help Centre & Contact Us";

    // Contact section ki details admin panel (Contact Us) se
    var contact = Db.ContactInfos.FirstOrDefault() ?? new ContactInfo();

    // Query form: login user ka naam/email pehle se, aur submit ke baad ka message
    var signedIn = User.Identity?.IsAuthenticated == true;
    var queryName = signedIn ? User.Identity!.Name : "";
    var queryEmail = signedIn ? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value : "";
    var querySent = TempData["QuerySent"] as string;
    var querySentEmail = TempData["QueryEmail"] as string;
    var queryError = TempData["QueryError"] as string;
}

