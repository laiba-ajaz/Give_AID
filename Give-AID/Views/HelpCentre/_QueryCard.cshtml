@model UserQuery
@{
    // Ek query: user ka sawal aur admin ka jawab. "Compact" = list ke andar (bahar ka card nahi chahiye)
    var compact = ViewData["Compact"] as bool? ?? false;
    var answered = !string.IsNullOrWhiteSpace(Model.AdminReply);
}

<div class="@(compact ? "" : "bg-surface-container-lowest rounded-2xl shadow-sm p-space-lg") flex flex-col gap-space-md">
    @if (!compact)
    {
        <div class="flex flex-wrap items-start justify-between gap-space-sm">
            <div>
                <span class="font-label-md text-label-md text-secondary uppercase tracking-wider font-bold">@Model.Reference</span>
                <h2 class="font-headline-sm text-headline-sm text-primary font-normal">@QueryTopics.Name(Model.Topic)</h2>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Sent by @Model.FullName on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>
            <div class="flex items-center gap-space-xs">
                @if (Model.IsUrgent)
                {
                    <span class="inline-flex items-center px-space-sm py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold uppercase">Urgent</span>
                }
                @if (Model.Status == QueryStatus.Answered)
                {
                    <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-tertiary-fixed/40 text-tertiary font-label-sm text-label-sm font-bold"><span class="material-symbols-outlined text-[14px]">mark_email_read</span> Answered</span>
                }
                else if (Model.Status == QueryStatus.Closed)
                {
                    <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-bold"><span class="material-symbols-outlined text-[14px]">lock</span> Closed</span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold"><span class="material-symbols-outlined text-[14px]">hourglass_top</span> Waiting for reply</span>
                }
            </div>
        </div>
    }

    <div class="bg-surface-container-low rounded-xl p-space-md">
        <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Your message</div>
        <p class="font-body-md text-body-md text-on-surface whitespace-pre-line">@Model.Message</p>
    </div>

    @if (answered)
    {
        <div class="border-l-4 border-secondary bg-surface-container-lowest rounded-r-xl p-space-md shadow-sm">
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-secondary uppercase tracking-wider font-bold mb-1">
                <span class="material-symbols-outlined text-[18px]">support_agent</span>
                Reply from Give-AID
                @if (Model.RepliedAt != null)
                {
                    <span class="text-outline font-normal normal-case tracking-normal">· @Model.RepliedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                }
            </div>
            <p class="font-body-md text-body-md text-on-surface whitespace-pre-line">@Model.AdminReply</p>
        </div>
    }
    else
    {
        <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-[18px] text-outline">schedule</span>
            Our team hasn't replied yet. Please check back soon@(Model.IsUrgent ? " – urgent queries are answered first" : "").
        </p>
    }
</div>
