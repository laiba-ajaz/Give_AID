<section class="w-full bg-primary text-on-primary py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin flex flex-col md:flex-row md:items-center justify-between gap-space-md">
    <div class="max-w-2xl">
        <h2 class="font-headline-md text-headline-md font-normal">Ready to make a difference?</h2>
        <p class="font-body-sm text-body-sm text-on-primary-container mt-space-xs">Choose a cause you care about or join one of our upcoming programmes.</p>
    </div>
    <div class="flex flex-wrap gap-space-sm">
        <a asp-controller="Donate" asp-action="Index" class="bg-secondary hover:bg-secondary-container text-on-secondary px-space-lg py-space-sm rounded-full font-label-lg text-label-lg uppercase tracking-wide transition-colors">Donate now</a>
        <a asp-controller="Programmes" asp-action="Index" class="border border-on-primary/40 hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-full font-label-lg text-label-lg uppercase tracking-wide transition-colors">View programmes</a>
    </div>
</div>
</section>
