@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var firstName = (User.Identity?.Name ?? "Admin").Split(' ')[0];
}

<section class="card welcome">
    <div>
        <h2>@greeting, @firstName</h2>
        <p>Here's what's happening across Give-AID today. Keep causes, NGOs, queries, and programmes up to date.</p>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-primary" asp-controller="Programmes" asp-action="Index">
            <span class="material-symbols-outlined">add</span> New programme
        </a>
        <a class="btn btn-ghost" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
            <span class="material-symbols-outlined">open_in_new</span> View website
        </a>
    </div>
</section>

<!-- ===== TOP STATS CARDS ===== -->
<section class="stats" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
    <!-- Total Aid Channeled Stat Card -->
    <a class="card stat" asp-controller="Donations" asp-action="Index">
        <span class="stat-icon" style="background:#d4edda; color:#155724;"><span class="material-symbols-outlined">payments</span></span>
        <div>
            <div class="stat-value">$@Model.TotalFundsRaised.ToString("N0")</div>
            <div class="stat-label">Aid Channeled</div>
            <div class="stat-sub">@Model.TotalDonationsCount donation@(Model.TotalDonationsCount == 1 ? "" : "s") processed</div>
        </div>
    </a>
    <a class="card stat" asp-controller="Users" asp-action="Index">
        <span class="stat-icon teal"><span class="material-symbols-outlined">group</span></span>
        <div>
            <div class="stat-value">@Model.TotalMembers</div>
            <div class="stat-label">Registered members</div>
            <div class="stat-sub">+@Model.NewMembersThisMonth this month</div>
        </div>
    </a>
    <a class="card stat" asp-controller="DonationCauses" asp-action="Index">
        <span class="stat-icon coral"><span class="material-symbols-outlined">volunteer_activism</span></span>
        <div>
            <div class="stat-value">@Model.ActiveCauses</div>
            <div class="stat-label">Active causes</div>
            <div class="stat-sub">@Model.TotalCauses in total</div>
        </div>
    </a>
    <a class="card stat" asp-controller="NGO" asp-action="Index">
        <span class="stat-icon mint"><span class="material-symbols-outlined">diversity_3</span></span>
        <div>
            <div class="stat-value">@Model.ActiveNgos</div>
            <div class="stat-label">Partner NGOs</div>
            <div class="stat-sub">@Model.TotalNgos in total</div>
        </div>
    </a>
    <a class="card stat" asp-controller="Programmes" asp-action="Index">
        <span class="stat-icon sand"><span class="material-symbols-outlined">event</span></span>
        <div>
            <div class="stat-value">@Model.UpcomingProgrammes</div>
            <div class="stat-label">Upcoming programmes</div>
            <div class="stat-sub">@Model.TotalProgrammes in total</div>
        </div>
    </a>
    <!-- User Queries Stat Card -->
    <a class="card stat" asp-controller="Queries" asp-action="Index">
        <span class="stat-icon" style="background:#e8def8; color:#6750a4;"><span class="material-symbols-outlined">forum</span></span>
        <div>
            <div class="stat-value">@Model.OpenQueries</div>
            <div class="stat-label">Open Queries</div>
            <div class="stat-sub">@Model.TotalQueries in total</div>
        </div>
    </a>
    <!-- Programme Volunteer Interests Stat Card -->
    <a class="card stat" asp-controller="ProgrammeInterests" asp-action="Index">
        <span class="stat-icon" style="background:#ffd8e4; color:#7d5260;"><span class="material-symbols-outlined">how_to_reg</span></span>
        <div>
            <div class="stat-value">@Model.TotalInterests</div>
            <div class="stat-label">Volunteer Interests</div>
            <div class="stat-sub">Registered participants</div>
        </div>
    </a>
</section>

<!-- ===== ROW 1: MEMBERS & UPCOMING PROGRAMMES ===== -->
<div class="grid-2">
    <section class="card">
        <div class="card-head">
            <h2>Newest members</h2>
            <a asp-controller="Users" asp-action="Index">View all →</a>
        </div>
        @if (Model.RecentMembers.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-outlined">person_off</span>
                <p>No one has registered yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>Member</th><th>City</th><th>Joined</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var m in Model.RecentMembers)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">
                                    <span class="avatar">@(string.IsNullOrEmpty(m.FullName) ? "?" : m.FullName.Substring(0, 1).ToUpper())</span>
                                    <div>
                                        <div class="cell-title">@m.FullName</div>
                                        <div class="cell-sub">@m.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(m.City ?? "—")</td>
                            <td class="nowrap muted">@m.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Coming up</h2>
            <a asp-controller="Programmes" asp-action="Index">All programmes →</a>
        </div>
        @if (Model.NextProgrammes.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-outlined">event_busy</span>
                <p>No upcoming programmes scheduled.</p>
            </div>
        }
        else
        {
            <ul class="list">
            @foreach (var p in Model.NextProgrammes)
            {
                <li>
                    <div class="date-tile">
                        <b>@p.StartDate.Day</b>
                        <span>@p.StartDate.ToString("MMM")</span>
                    </div>
                    <div class="list-main">
                        <div class="list-title">@p.Title</div>
                        <div class="list-sub">
                            @p.NGO?.NGOName
                            @if (!string.IsNullOrEmpty(p.Location)) { <text> · @p.Location</text> }
                        </div>
                    </div>
                    @if (p.StartDate <= DateTime.Today)
                    {
                        <span class="badge badge-green">Running</span>
                    }
                </li>
            }
            </ul>
        }
    </section>
</div>

<!-- ===== ROW 2: RECENT DONATIONS & RECENT QUERIES ===== -->
<div class="grid-2" style="margin-top:20px;">
    <!-- Recent Donations -->
    <section class="card">
        <div class="card-head">
            <h2>Recent Donations</h2>
            <a asp-controller="Donations" asp-action="Index">View all donations →</a>
        </div>
        @if (Model.RecentDonations.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-outlined">payments</span>
                <p>No donations processed yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>Donor</th><th>Cause</th><th>Amount</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.RecentDonations)
                    {
                        var donorName = d.User?.FullName ?? "Anonymous";
                        <tr>
                            <td>
                                <div class="cell-main">
                                    <span class="avatar">@(string.IsNullOrEmpty(donorName) ? "?" : donorName.Substring(0, 1).ToUpper())</span>
                                    <div>
                                        <div class="cell-title">@donorName</div>
                                        <div class="cell-sub">@(d.User?.Email ?? "—")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title" style="font-size:13px; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @(d.DonationCause?.CauseName ?? "Community")
                                </div>
                            </td>
                            <td>
                                <span style="font-weight:bold; color:#0b6623;">$@d.TotalCharged.ToString("N2")</span>
                            </td>
                            <td class="nowrap muted" style="font-size:12px;">@d.CreatedAt.ToString("dd MMM, hh:mm tt")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Recent Queries (Help Centre) -->
    <section class="card">
        <div class="card-head">
            <h2>Recent User Queries</h2>
            <a asp-controller="Queries" asp-action="Index">View all queries →</a>
        </div>
        @if (Model.RecentQueries.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-outlined">inbox</span>
                <p>No user queries received yet.</p>
            </div>
        }
        else
        {
            <ul class="list">
            @foreach (var q in Model.RecentQueries)
            {
                <li>
                    <span class="avatar">@(string.IsNullOrEmpty(q.FullName) ? "?" : q.FullName.Substring(0, 1).ToUpper())</span>
                    <div class="list-main">
                        <div class="list-title" style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                            <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@q.FullName</span>
                            @if (q.Status == QueryStatus.Open)
                            {
                                <span class="badge @(q.IsUrgent ? "badge-red" : "badge-amber")" style="flex-shrink:0;">@(q.IsUrgent ? "Urgent" : "Open")</span>
                            }
                            else if (q.Status == QueryStatus.Answered)
                            {
                                <span class="badge badge-green" style="flex-shrink:0;">Answered</span>
                            }
                            else
                            {
                                <span class="badge badge-muted" style="flex-shrink:0;">@q.Status</span>
                            }
                        </div>
                        <div class="list-sub" style="display:flex; justify-content:space-between; align-items:center; margin-top:3px; gap:8px;">
                            <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px;">@QueryTopics.Name(q.Topic) &middot; <span class="muted">@q.CreatedAt.ToString("dd MMM")</span></span>
                            <a asp-controller="Queries" asp-action="Details" asp-route-id="@q.UserQueryId" style="color:var(--primary); font-weight:600; font-size:12px; text-decoration:none; flex-shrink:0;">Reply &rarr;</a>
                        </div>
                    </div>
                </li>
            }
            </ul>
        }
    </section>
</div>

<!-- ===== ROW 3: VOLUNTEER & PROGRAMME REGISTRATIONS ===== -->
<div style="margin-top:20px;">
    <section class="card">
        <div class="card-head">
            <h2>Volunteer &amp; Programme Interests</h2>
            <a asp-controller="ProgrammeInterests" asp-action="Index">View all volunteers →</a>
        </div>
        @if (Model.RecentInterests.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-outlined">person_pin</span>
                <p>No volunteer registrations yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>Volunteer</th><th>Programme</th><th>Role</th><th>Phone / Contact</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var pi in Model.RecentInterests)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">
                                    <span class="avatar">@(string.IsNullOrEmpty(pi.Name) ? "?" : pi.Name.Substring(0, 1).ToUpper())</span>
                                    <div>
                                        <div class="cell-title">@pi.Name</div>
                                        <div class="cell-sub">@pi.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title" style="font-size:13px; max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @(pi.Programme?.Title ?? $"Programme #{pi.ProgrammeId}")
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-blue">@pi.ParticipationRole</span>
                            </td>
                            <td class="muted" style="font-size:13px;">
                                @(string.IsNullOrEmpty(pi.Phone) ? "—" : pi.Phone)
                            </td>
                            <td class="nowrap muted" style="font-size:12px;">@pi.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
