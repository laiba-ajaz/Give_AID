@model List<Programme>
@{
    ViewData["Title"] = "Programmes";
    var ngos = ViewBag.NGOs as List<NGO> ?? new List<NGO>();
    var causes = ViewBag.Causes as List<DonationCauses> ?? new List<DonationCauses>();
}

<h1>Programmes</h1>

@if (TempData["Success"] != null) { <p class="alert-success">@TempData["Success"]</p> }
@if (TempData["Error"] != null)   { <p class="alert-error">@TempData["Error"]</p> }

@if (ngos.Count == 0 || causes.Count == 0)
{
    <p class="alert-error">For adding the programme , one donation Cause and one NGO is necessary.</p>
}
else
{
    <button type="button" onclick="document.getElementById('addProgrammeModal').showModal()">
        + Add Programme
    </button>
}

<table>
    <thead>
        <tr><th>ID</th><th>Title</th><th>NGO</th><th>Cause</th><th>Location</th><th>Dates</th><th>Active</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProgrammeId</td>
            <td>@p.Title</td>
            <td>@p.NGO?.NGOName</td>
            <td>@p.Cause?.CauseName</td>
            <td>@p.Location</td>
            <td>
                @p.StartDate.ToString("dd MMM yyyy")
                @if (p.EndDate != null) { <text> – @p.EndDate.Value.ToString("dd MMM yyyy")</text> }
            </td>
            <td>
                <form asp-action="ToggleActive" asp-route-id="@p.ProgrammeId" method="post" class="toggle-form">
                    <label class="switch" title="@(p.isActive ? "Active — click to deactivate" : "Inactive — click to activate")">
                        <input type="checkbox" @(p.isActive ? "checked" : "") onchange="this.form.submit()" />
                        <span class="slider"></span>
                    </label>
                </form>
            </td>
            <td class="actions">
                <button type="button" class="btn-edit"
                        data-id="@p.ProgrammeId"
                        data-title="@p.Title"
                        data-description="@p.Description"
                        data-image="@p.ImagePath"
                        data-location="@p.Location"
                        data-start="@p.StartDate.ToString("yyyy-MM-dd")"
                        data-end="@(p.EndDate?.ToString("yyyy-MM-dd"))"
                        data-ngo="@p.NGOID"
                        data-cause="@p.DonationCausesID"
                        data-active="@(p.isActive ? "true" : "false")"
                        onclick="openEditModal(this)">
                    Edit
                </button>

                <form asp-action="DltProgramme" asp-route-id="@p.ProgrammeId" method="post"
                      data-name="@p.Title"
                      onsubmit="return confirm('Delete &quot;' + this.dataset.name + '&quot;? This cannot be undone.');">
                    <button type="submit" class="btn-delete">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="8">No programmes added yet.</td></tr>
    }
    </tbody>
</table>

<!-- ===== Add Programme Modal ===== -->
<dialog id="addProgrammeModal">
    <form asp-action="AddProgramme" method="post">
        <h2>Add Programme</h2>

        <label>Title</label>
        <input name="Title" maxlength="100" required />

        <label>Description</label>
        <textarea name="Description" maxlength="500" required></textarea>

        <label>NGO</label>
        <select name="NGOID" required>
            <option value="">-- Select NGO --</option>
            @foreach (var n in ngos) { <option value="@n.NGOID">@n.NGOName</option> }
        </select>

        <label>Donation Cause</label>
        <select name="DonationCausesID" required>
            <option value="">-- Select Cause --</option>
            @foreach (var c in causes) { <option value="@c.DonationCausesID">@c.CauseName</option> }
        </select>

        <label>Location</label>
        <input name="Location" maxlength="100" />

        <label>Start Date</label>
        <input type="date" name="StartDate" required />

        <label>End Date</label>
        <input type="date" name="EndDate" />

        <label>Image Path</label>
        <input name="ImagePath" />

        <label><input type="checkbox" name="isActive" value="true" checked /> Active</label>

        <div>
            <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit">Save</button>
        </div>
    </form>
</dialog>

<!-- ===== Edit Programme Modal ===== -->
<dialog id="editProgrammeModal">
    <form asp-action="EditProgramme" method="post">
        <h2>Edit Programme</h2>

        <input type="hidden" name="ProgrammeId" id="editId" />

        <label>Title</label>
        <input name="Title" id="editTitle" maxlength="100" required />

        <label>Description</label>
        <textarea name="Description" id="editDescription" maxlength="500" required></textarea>

        <label>NGO</label>
        <select name="NGOID" id="editNgo" required>
            @foreach (var n in ngos) { <option value="@n.NGOID">@n.NGOName</option> }
        </select>

        <label>Donation Cause</label>
        <select name="DonationCausesID" id="editCause" required>
            @foreach (var c in causes) { <option value="@c.DonationCausesID">@c.CauseName</option> }
        </select>

        <label>Location</label>
        <input name="Location" id="editLocation" maxlength="100" />

        <label>Start Date</label>
        <input type="date" name="StartDate" id="editStart" required />

        <label>End Date</label>
        <input type="date" name="EndDate" id="editEnd" />

        <label>Image Path</label>
        <input name="ImagePath" id="editImage" />

        <label><input type="checkbox" name="isActive" id="editActive" value="true" /> Active</label>

        <div>
            <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit">Update</button>
        </div>
    </form>
</dialog>

@section Scripts {
<script>
    // Agar programme ka NGO/Cause ab inactive hai to woh dropdown mein nahi hoga,
    // is liye usay temporary option ke taur par add kar dete hain taake data change na ho.
    function selectOrAdd(select, value, label) {
        if (![...select.options].some(o => o.value === value)) {
            select.add(new Option(label + ' (inactive)', value));
        }
        select.value = value;
    }

    function openEditModal(btn) {
        const row = btn.closest('tr');
        document.getElementById('editId').value = btn.dataset.id;
        document.getElementById('editTitle').value = btn.dataset.title;
        document.getElementById('editDescription').value = btn.dataset.description;
        document.getElementById('editLocation').value = btn.dataset.location || '';
        document.getElementById('editStart').value = btn.dataset.start;
        document.getElementById('editEnd').value = btn.dataset.end || '';
        document.getElementById('editImage').value = btn.dataset.image || '';
        selectOrAdd(document.getElementById('editNgo'), btn.dataset.ngo, row.cells[2].textContent.trim());
        selectOrAdd(document.getElementById('editCause'), btn.dataset.cause, row.cells[3].textContent.trim());
        document.getElementById('editActive').checked = btn.dataset.active === 'true';
        document.getElementById('editProgrammeModal').showModal();
    }
</script>
}
